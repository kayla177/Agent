<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.kayla.daily-agents.jobscraper</string>

    <!-- Run: uv run python scripts/run_job_scraper.py --send  -->
    <key>ProgramArguments</key>
    <array>
        <string>/Users/kayla.li/.local/bin/uv</string>
        <string>run</string>
        <string>python</string>
        <string>scripts/run.py</string>
        <string>job_scraper</string>
        <string>--send</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/kayla.li/dev/daily-agents</string>

    <!-- Fire twice daily: 08:00 and 17:00 local time. -->
    <key>StartCalendarInterval</key>
    <array>
        <dict>
            <key>Hour</key>
            <integer>8</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
        <dict>
            <key>Hour</key>
            <integer>17</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
    </array>

    <key>StandardOutPath</key>
    <string>/Users/kayla.li/dev/daily-agents/jobscraper.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/kayla.li/dev/daily-agents/jobscraper.error.log</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
