// MIRROR ONLY. The root `schema.sql` is the source of truth and this file is
// derived from it (`npx prisma db pull` against a DB built from schema.sql);
// `npm run db:check` fails the build if the two disagree.
//
// DEPLOYMENT ORDERING when a column is added here — the one rule, and it is the
// reverse of the Prisma-shaped instinct:
//
//   Run the PYTHON migration against the live DB BEFORE the regenerated client
//   serves a read of the new column.
//
// `npx prisma generate` only rewrites a TypeScript client; it does not touch the
// database. The only thing that ALTERs an existing `data/control_center.db` is
// `store_db.py:_migrate`, which runs from `init_db()` — i.e. when a Python
// process starts (server/, scripts/run.py, a launchd agent). Regenerate first
// and restart Next.js, and every request to the applications page 500s with
// `no such column: <name>` until some Python process happens to run. It does
// self-heal (the jobscraper calls `init_db()` on schedule and `_migrate` is
// additive and idempotent), but the fix costs nothing: restart the FastAPI
// service, or `.venv/bin/python -c "import store_db; store_db.init_db()"`, and
// only then rebuild the Next side. `confirmed_at` below is the column this was
// learned on.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:../../data/control_center.db"
}

model applications {
  id             Int     @id @default(autoincrement())
  company        String
  role           String
  url            String  @default("")
  status         String  @default("applied")
  applied_date   String
  updated_date   String
  notes          String  @default("")
  auto_detected  Int     @default(0)
  resume_job_id  String?
  resume_pdf_key String?
  job_id         String?
  // ISO8601 UTC instant at which a real submission was verified on an ATS
  // confirmation page (agents/job_applier/confirm.py). NULL means "unverified",
  // not "not submitted" — every row is recorded optimistically when the user
  // confirms the apply modal, and only a positive match ever stamps this.
  confirmed_at   String?
}

model node_events {
  id      Int     @id @default(autoincrement())
  run_id  Int
  node    String
  status  String
  ts      String
  payload String?
  runs    runs    @relation(fields: [run_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([run_id, id], map: "idx_node_events_run")
}

model runs {
  id             Int           @id @default(autoincrement())
  agent_key      String
  status         String
  send           Int           @default(0)
  started_at     String
  finished_at    String?
  output_message String?
  error          String?
  node_events    node_events[]

  @@index([started_at(sort: Desc)], map: "idx_runs_started")
  @@index([agent_key, started_at(sort: Desc)], map: "idx_runs_agent_started")
}

model jobs {
  id           String  @id
  company      String  @default("")
  title        String  @default("")
  location     String  @default("")
  url          String  @default("")
  status       String  @default("new")
  ats          String  @default("")
  posted_at    String?
  remote       Int?
  compensation String?
  department   String?
  description  String?
  fit_score    Float?
  fit_reason   String?
  ghost        Int     @default(0)
  ghost_reason String  @default("")
  also_on      String  @default("[]")
  country      String  @default("")
  // Undergrad-eligibility screen. Tagged, never dropped — hidden by default in
  // the UI like an out-of-country row. Default 1: only an explicit judgement
  // hides a posting.
  eligible        Int    @default(1)
  eligible_reason String @default("")
  first_seen   String  @default("")
  last_seen    String  @default("")
  data         String  @default("{}")

  @@index([company], map: "idx_jobs_company")
  @@index([status], map: "idx_jobs_status")
  @@index([country], map: "idx_jobs_country")
}

// Resume generator (feature/resume-generator). Tables are created by the Python
// agent's store (agents/resume_generator/store.py); these models mirror that
// shape so the client can read/write them — the same result a `prisma db pull`
// would produce.
model experience_docs {
  id       Int    @id @default(autoincrement())
  filename String @default("")
  kind     String @default("resume") // resume | project
  text     String @default("")
  added_at String @default("")
}

model resumes {
  job_id     String @id
  company    String @default("")
  role       String @default("")
  markdown   String @default("")
  latex      String @default("")
  keywords   String @default("[]") // JSON array of strings
  status     String @default("draft") // draft | final
  created_at String @default("")
  updated_at String @default("")
}

model master_resume {
  id         Int    @id @default(autoincrement())
  markdown   String @default("")
  latex      String @default("")
  keywords   String @default("[]") // JSON array of strings
  updated_at String @default("")
}

model resume_versions {
  id         Int    @id @default(autoincrement())
  job_id     String
  markdown   String @default("")
  keywords   String @default("[]") // JSON array of strings
  status     String @default("draft")
  created_at String @default("")

  @@index([job_id], map: "idx_resume_versions_job")
}

model master_cover_letter {
  id         Int    @id @default(autoincrement())
  body       String @default("")
  updated_at String @default("")
}

model cover_letters {
  job_id     String @id
  company    String @default("")
  role       String @default("")
  body       String @default("")
  status     String @default("draft")
  created_at String @default("")
  updated_at String @default("")
}

model cover_letter_versions {
  id         Int    @id @default(autoincrement())
  job_id     String
  body       String @default("")
  status     String @default("")
  created_at String @default("")

  @@index([job_id], map: "idx_cover_letter_versions_job")
}

// Stock digest — persisted analysis snapshots. Created by the Python agent's
// store (agents/stock_digest/store.py); mirrors schema.sql. The '__market__'
// symbol row carries the overview blob; every other row is one analyzed ticker.
model stock_analysis {
  symbol  String
  run_at  String
  verdict String @default("")
  score   Int?
  signal  String @default("")
  price   Float?
  pct     Float?
  data    String @default("{}")

  @@id([run_at, symbol])
  @@index([run_at(sort: Desc)], map: "idx_stock_analysis_run")
}

// Applicant profile — one row (id is always 1, enforced by profile_store).
// Typed fields exist so no LLM ever invents a phone number or a work-
// authorization answer into a submitted application form.
model applicant_profile {
  id                Int    @id @default(autoincrement())
  full_name         String @default("")
  email             String @default("")
  phone             String @default("")
  location          String @default("")
  linkedin_url      String @default("")
  github_url        String @default("")
  portfolio_url     String @default("")
  school            String @default("")
  degree            String @default("")
  grad_date         String @default("")
  us_work_auth      String @default("")
  ca_work_auth      String @default("")
  needs_sponsorship Int    @default(0)
  summary           String @default("")
  updated_at        String @default("")
}
