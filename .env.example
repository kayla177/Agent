# Copy to .env and fill in. .env is gitignored — never commit real values.

# --- Discord (Phase 1) ---
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=

# --- Google Maps Routes API (commute node) ---
GOOGLE_MAPS_API_KEY=

# --- Google Calendar OAuth (calendar node) ---
# Path to the OAuth client secrets JSON you download from Google Cloud Console.
GOOGLE_OAUTH_CLIENT_FILE=google_oauth_client.json
# Where the minted user token gets cached after first consent (auto-created).
GOOGLE_TOKEN_FILE=google_token.json

# --- Hosted model (deferred; only needed when an agent uses the "smart" role) ---
ANTHROPIC_API_KEY=

# --- Twelve Data (stock digest) — free key at https://twelvedata.com/pricing ---
# Optional: enables real price history + technical indicators. Without it the
# digest falls back to keyless CNBC quotes (no indicators).
TWELVE_DATA_API_KEY=

# --- Alpaca PAPER trading (paper_trader agent) — SIMULATED money only ---
# Create a free Paper account at https://alpaca.markets, then Generate API keys.
# Leave blank to run the trader in dry-run (it decides but places no orders).
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
# Keep this on paper-api so real money is never touched.
ALPACA_BASE_URL=https://paper-api.alpaca.markets
